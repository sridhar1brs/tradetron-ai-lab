    },
    {
      "variableName": "HedgeRoll",
      "value": "( tt_Number ( '100' )  )",
      "display": "( Number ( '100' )  )",
      "json": "{\"operator\": \"and\", \"operands\": [{\"type\": \"rule\", \"value\": \"builder-basic_rule_0\", \"elements\": [{\"name\": \"Number\", \"kid\": 4187, \"params\": [{\"type\": \"value\", \"value\": \"100\"}]}]}]}"
    },
