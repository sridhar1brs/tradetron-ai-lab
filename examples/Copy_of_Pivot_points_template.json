  "pythonCode": "if tt_Time('NSE')<925:\r\n    ins = '|THOMAS|'\r\n    if not tt_get_runtime(ins+'_updated') and tt_get_runtime(ins+'_updated') != tt_Today('NSE'):\r\n        prev_c = (tt_get_element(tt_CLOSE(tt_get_data(ins, 'day', '10')), '-1'))\r\n        prev_l = (tt_get_element(tt_LOW(tt_get_data(ins, 'day', '10')), '-1'))\r\n        prev_h = (tt_get_element(tt_HIGH(tt_get_data(ins, 'day', '10')), '-1'))\r\n\r\n        pp = (prev_c+prev_l+prev_h)/3\r\n        bc = (prev_l+prev_h)/2\r\n        tc = 2 * pp - bc\r\n        r1 = 2*pp - prev_l\r\n        r2 = pp + (prev_h-prev_l)\r\n        r3 = pp + 1.5 * (prev_h-prev_l)\r\n        r4 = pp + 2 * (prev_h-prev_l)\r\n        r5 = pp +  2.5 * (prev_h-prev_l)\r\n        s1 = 2* pp - prev_h\r\n        s2 = pp - (prev_h-prev_l)\r\n        s3 = pp - 1.5 * (prev_h-prev_l)\r\n        s4 = pp - 2 * (prev_h-prev_l)\r\n        s5 = pp - 2.5 * (prev_h-prev_l)\r\n\r\n        tt_set_runtime(ins+'_pp',pp)\r\n        tt_set_runtime(ins+'_bc',bc)\r\n        tt_set_runtime(ins+'_tc',tc)\r\n        tt_set_runtime(ins+'_r1',r1)\r\n        tt_set_runtime(ins+'_r2',r2)\r\n        tt_set_runtime(ins+'_r3',r3)\r\n        tt_set_runtime(ins+'_r4',r4)\r\n        tt_set_runtime(ins+'_r5',r5)\r\n        tt_set_runtime(ins+'_s1',s1)\r\n        tt_set_runtime(ins+'_s2',s2)\r\n        tt_set_runtime(ins+'_s3',s3)\r\n        tt_set_runtime(ins+'_s4',s4)\r\n        tt_set_runtime(ins+'_s5',s5)\r\n        tt_set_runtime(ins+'_updated', tt_Today('NSE'))",
